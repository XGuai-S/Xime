<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!--
      用户配置目录 /storage/emulated/0/rime/xime/ 的写入权限。
      - API 30+：需要「所有文件访问」，用户在系统设置里手动授予（设置页提供跳转入口）。
      - API 28/29：WRITE_EXTERNAL_STORAGE 运行时权限，仅声明到 29。
      未授权时应用回退私有目录 + 内置文件管理器，功能不缺失。
    -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    
    <application
        android:name=".XimeApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Xime"
        tools:targetApi="31">
        
        <!-- 主Activity -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Xime">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 接收其他应用分享的 .yaml / .zip 文件 -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>
        
        <!-- 输入法服务 -->
        <service
            android:name=".service.XimeInputMethodService"
            android:exported="true"
            android:label="@string/ime_service_label"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>
        
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/filepaths" />
        </provider>
        
        <!-- AI 模型推理服务（独立进程，crash 不影响 IME） -->
        <service
            android:name=".service.InferenceService"
            android:exported="false"
            android:process=":inference" />
        
        <!-- 离线语音识别服务（独立进程，模型推理不占用输入法进程内存） -->
        <service
            android:name=".service.AsrInferenceService"
            android:exported="false"
            android:process=":asr" />

        <!-- xipm dev 插件热安装入口（debug/release 通用，由"插件开发模式"开关门禁）：
             exported=true 供 adb shell am start 拉起（Android 15 起 shell 无法启动非导出组件）；
             组件本身无界面、装完即 finish，release 下开关关闭时不读 path、不安装 -->
        <activity
            android:name=".plugin.DevPluginInstallActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

    </application>

    <!-- 「用其他应用打开配置目录」需要在 Android 11+ 看见文件管理器。
         分两类声明：
         1. <intent> 按能力发现：声明「能 VIEW 任意类型 / 能打开文档树」的应用都可见，
            覆盖清单外的第三方管理器，也是 queryIntentActivities 返回结果的前提；
         2. <package> 按包名探测：MT管理器、MiXplorer 等多数管理器并不声明目录 MIME，
            只能按包名判断是否安装，不声明就探测不到。 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="*/*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.OPEN_DOCUMENT_TREE" />
        </intent>
        <package android:name="bin.mt.plus" />
        <package android:name="bin.mt.plus.canary" />
        <package android:name="pl.solidexplorer2" />
        <package android:name="com.estrongs.android.pop" />
        <package android:name="com.mixplorer" />
        <package android:name="com.mixplorer.beta" />
        <package android:name="com.mixplorer.silver" />
        <package android:name="com.speedsoftware.rootexplorer" />
        <package android:name="com.speedsoftware.explorer" />
        <package android:name="com.google.android.apps.nbu.files" />
        <package android:name="com.google.android.documentsui" />
        <package android:name="com.android.documentsui" />
        <package android:name="com.mi.android.globalFileexplorer" />
        <package android:name="com.huawei.filemanager" />
        <package android:name="com.coloros.filemanager" />
        <package android:name="com.vivo.filemanager" />
        <package android:name="com.oppo.filemanager" />
        <package android:name="net.micode.fileexplorer" />
        <package android:name="com.zte.filemanager" />
        <package android:name="com.sec.android.app.myfiles" />
        <package android:name="com.lge.filemanager" />
        <package android:name="com.htc.filemanager" />
        <package android:name="com.asus.filemanager" />
        <package android:name="com.motorola.filemanager" />
        <package android:name="com.sonymobile.explorer" />
        <package android:name="com.qihoo360.mobilesafe.filemanager" />
        <package android:name="com.qihoo.filemanager" />
        <package android:name="com.lionmobi.filemanager" />
    </queries>

</manifest>
